# Forge3D local API. The installers create runtime/engine.env automatically.
LOCAL3D_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL3D_MAX_UPLOAD_MB=25
LOCAL3D_DEMO_FALLBACK=false

# Managed trellis.cpp service
ENGINE_PROFILE=8gb
TRELLIS_SERVER_URL=http://127.0.0.1:8091
TRELLIS_SERVER_BIN=
TRELLIS_MODELS_DIR=
TRELLIS_MANAGED_PID_FILE=
TRELLIS_RELEASE_SCRIPT=
TRELLIS_DEFAULT_RESOLUTION=512
TRELLIS_DEFAULT_ATLAS=1024
ENGINE_PROFILE_PATH=

# Structured UltraShape worker — no arbitrary command template is supported.
ULTRASHAPE_ENABLED=0
ULTRASHAPE_HOME=
ULTRASHAPE_PYTHON=
ULTRASHAPE_CKPT=
ULTRASHAPE_WORKER=
ULTRASHAPE_PROBE_PATH=
ULTRASHAPE_INSTALL_STATUS=
ULTRASHAPE_TIMEOUT_SECONDS=900

# FaithC geometry-only artifact. Build FaithC and Atom3d in a dedicated venv.
FAITHC_ENABLED=0
FAITHC_PYTHON=
FAITHC_WORKER=
FAITHC_TIMEOUT_SECONDS=900
FAITHC_PROBE_TIMEOUT_SECONDS=90
